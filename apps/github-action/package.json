{
  "name": "@review-assist/github-action",
  "version": "0.1.0",
  "description": "GitHub Action that validates the Intent Document and posts the guided-review summary.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node20 --format=cjs --outfile=dist/main.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.0",
    "@review-assist/schema": "0.1.0",
    "@review-assist/validator": "0.1.0"
  },
  "devDependencies": {
    "esbuild": "^0.24.0"
  }
}

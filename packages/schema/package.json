{
  "name": "@review-assist/schema",
  "version": "0.1.0",
  "description": "JSON Schema and TypeScript types for the Intent Document format.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema.json": "./src/intent-doc.schema.json"
  },
  "files": [
    "dist",
    "src/intent-doc.schema.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && cp src/intent-doc.schema.json dist/intent-doc.schema.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

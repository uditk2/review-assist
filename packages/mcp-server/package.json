{
  "name": "review-assist-mcp",
  "version": "0.2.2",
  "description": "MCP server that turns an AI agent's coding session into a reviewable Intent Document — a two-agent author/reviewer distillation, gatekept by a deterministic validator. Works with Claude Code and Codex.",
  "license": "Apache-2.0",
  "type": "module",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-review",
    "claude-code",
    "codex",
    "ai-agents",
    "pull-request",
    "github",
    "intent-document"
  ],
  "homepage": "https://github.com/uditk2/review-assist",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uditk2/review-assist.git",
    "directory": "packages/mcp-server"
  },
  "bugs": {
    "url": "https://github.com/uditk2/review-assist/issues"
  },
  "bin": {
    "review-assist-mcp": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "agents",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node ../../scripts/sync-version.mjs && esbuild src/index.ts --bundle --platform=node --format=esm --target=node18 --loader:.md=text --loader:.toml=text --outfile=dist/index.js",
    "mcpb:pack": "npm run build && npx --yes @anthropic-ai/mcpb pack . ../../review-assist-mcp.mcpb",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@review-assist/schema": "0.1.0",
    "@review-assist/validator": "0.1.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.23.8",
    "esbuild": "^0.21.5"
  }
}

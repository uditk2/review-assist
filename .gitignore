node_modules/
dist/
# Except the plugin's server: the plugin directory installs a plugin from the repository as
# committed, so its built server has to be in git. scripts/build-plugin.mjs writes it.
!plugins/review-assist/server/dist/
*.log
.wrangler/

# schema copied into the viewer assets at build time so the $id URL resolves
apps/github-app/viewer/schema/
scripts/out-*.png
scripts/frames/

# built MCP bundle (ship as a release asset, not committed)
*.mcpb

# Generated by `review-assist-mcp agents --write` — machine-specific paths
.codex/
.claude/agents/
